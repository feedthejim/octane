{
  "name": "@octanejs/next",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "Turbopack integration for hosting Octane client components in Next.js App Router applications",
  "author": {
    "name": "Dominic Gannaway",
    "email": "dg@domgan.com"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octanejs/octane.git",
    "directory": "packages/next"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "module": "src/index.js",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./compat": {
      "types": "./types/compat.d.ts",
      "browser": "./src/compat.client.js",
      "default": "./src/compat.server.js"
    },
    "./loader": {
      "types": "./types/loader.d.ts",
      "import": "./src/loader.js",
      "default": "./src/loader.js"
    }
  },
  "scripts": {
    "test": "vitest run --config vitest.config.js",
    "typecheck": "tsgo --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@tsrx/core": "catalog:default"
  },
  "peerDependencies": {
    "next": ">=16.2.0",
    "octane": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "catalog:default",
    "next": "^16.2.0",
    "octane": "workspace:*",
    "react": "catalog:default",
    "react-dom": "catalog:default",
    "vitest": "catalog:default"
  }
}
